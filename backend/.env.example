# Backend environment variables example
# Required
JWT_SECRET=your_jwt_secret_here
# Optional: MongoDB connection string (if not set, in-memory DB will be used for development)
# MONGO_URI=mongodb+srv://user:pass@cluster0.xyz.mongodb.net/plateplanner

# FRONTEND_URL used to build verification link (default http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# SMTP settings for real email sending (SendGrid example)
# For SendGrid SMTP: user is usually 'apikey' and pass is the API key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
# If using port 465 set SMTP_SECURE=true
SMTP_SECURE=false
EMAIL_FROM=no-reply@yourdomain.com
